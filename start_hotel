#!/bin/bash

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/hms-backend"
FRONTEND_DIR="$SCRIPT_DIR/hms-frontend"

# Function to check if dependencies are installed
check_dependencies() {
  local dir=$1
  local dir_name=$2
  
  if [ ! -d "$dir/node_modules" ]; then
    echo "Installing $dir_name dependencies..."
    cd "$dir"
    npm install
    cd "$SCRIPT_DIR"
  fi
}

# Function to wait for a port to be ready
wait_for_port() {
  local port=$1
  local max_attempts=30
  local attempt=1
  
  while [ $attempt -le $max_attempts ]; do
    if nc -z localhost $port 2>/dev/null; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  
  return 1
}

# Check if required directories exist
if [ ! -d "$BACKEND_DIR" ]; then
  echo "Error: Backend directory not found"
  exit 1
fi

if [ ! -d "$FRONTEND_DIR" ]; then
  echo "Error: Frontend directory not found"
  exit 1
fi

# Check dependencies silently
check_dependencies "$BACKEND_DIR" "Backend"
check_dependencies "$FRONTEND_DIR" "Frontend"

# Check port availability
if nc -z localhost 4000 2>/dev/null; then
  echo "Error: Port 4000 is already in use"
  exit 1
fi

if nc -z localhost 5173 2>/dev/null; then
  echo "Error: Port 5173 is already in use"
  exit 1
fi

# Start backend silently
cd "$BACKEND_DIR"
node server.js > /dev/null 2>&1 &
BACKEND_PID=$!

# Wait for backend to be ready
if ! wait_for_port 4000; then
  echo "Error: Backend failed to start"
  kill $BACKEND_PID 2>/dev/null || true
  exit 1
fi

# Start frontend silently
cd "$FRONTEND_DIR"
npm run dev > /dev/null 2>&1 &
FRONTEND_PID=$!

# Wait for frontend to be ready
sleep 3
if ! wait_for_port 5173; then
  sleep 2
fi

# Success message
echo ""
echo "Hotel Management System - Started"
echo "Access at: http://localhost:5173"
echo ""
echo "Press Ctrl+C to stop..."
echo ""

# Handle cleanup on exit
trap "echo ''; echo 'Stopping...'; kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true; exit 0" INT TERM

wait
